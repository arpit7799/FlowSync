# Application
APP_NAME=FlowSync
APP_ENV=development
DEBUG=true

# Backend
API_HOST=127.0.0.1
API_PORT=8000

# Database
DATABASE_URL=postgresql+psycopg://flowsync:flowsync@localhost:5432/flowsync

# MQTT
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=

# Simulation
SUMO_GUI=true
SUMO_CONFIG_PATH=simulation/sumo/config/flowsync.sumocfg

# Logging
LOG_LEVEL=INFO
